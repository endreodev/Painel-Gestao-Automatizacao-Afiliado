# ---------------------------------------------------------------------------
# ml-group - copie este arquivo para .env e preencha
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# WhatsApp
# ---------------------------------------------------------------------------
# Driver padrao: 'ponte'. Conecta lendo o QR code, sem servidor externo nem
# servico pago. Basta rodar:  php bin/mlgroup conectar
#
# Outros drivers, se voce ja tiver a infra pronta:
#   evolution | zapi | wppconnect      (gateways externos)
#   simulado                           (imprime no terminal, nao envia nada)
#
# ATENCAO: a Cloud API oficial da Meta NAO envia para grupos - por isso todos
# os drivers acima falam com o WhatsApp Web.
WHATSAPP_DRIVER=ponte

# Preenchido automaticamente por:  php bin/mlgroup grupos
# Varios grupos: separe por virgula.
WHATSAPP_GRUPOS=

# Porta local da ponte (mude so se 8787 ja estiver em uso)
PONTE_PORTA=8787

# --- Evolution API (self-hosted, gratuita) ---
WHATSAPP_URL=http://localhost:8080
WHATSAPP_INSTANCIA=mlgroup
WHATSAPP_TOKEN=

# --- Z-API (servico pago) ---
ZAPI_INSTANCIA=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# --- WPPConnect Server (self-hosted) ---
WPP_URL=http://localhost:21465
WPP_SESSAO=mlgroup
WPP_TOKEN=

# ---------------------------------------------------------------------------
# Mercado Livre - afiliado
# ---------------------------------------------------------------------------
# Sua tag/identificador do Programa de Afiliados. Sem ela o link vai sem
# rastreio e a venda nao e creditada.
ML_AFILIADO_TAG=
ML_AFILIADO_FERRAMENTA=82183

# Token de acesso da API do ML (opcional).
# Sem token, a busca por API costuma responder 401 e o sistema cai
# automaticamente para a coleta via navegador - que e o modo principal.
ML_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Encurtador de link (opcional)
# ---------------------------------------------------------------------------
ENCURTADOR_TOKEN=
